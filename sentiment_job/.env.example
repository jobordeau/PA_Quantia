# =====================================
# PostgreSQL connection string
# =====================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# When running via docker-compose, the host is "postgres".
# When running locally against a host Postgres, use "localhost".
PG_CONN=postgresql://postgres:changeme@postgres:5432/quantia

# =====================================
# Reddit API
# =====================================
# Register a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
USER_AGENT=quantia-sentiment-bot/0.1.0 (by u/your_username)

# =====================================
# OpenAI API (used by summarizer.py)
# =====================================
# Generate at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key

# =====================================
# Pipeline tunables (optional)
# =====================================
ASSET=bitcoin
HOURS_BACK=24
MAX_TOTAL=20000
MIN_REQUIRED=3000
COMMENT_LIMIT=1000
TOP_K_DISPLAY=8
TAU_HOURS=6
START_DATE=2025-06-14
LOG_LEVEL=INFO
