# =====================================
# Quantia — root environment configuration
# Copy this file to ".env" and fill in the values
# =====================================

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quantia
POSTGRES_PORT=5432

# --- Web application ---
ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=8080

# --- ML prediction API (FastAPI service that returns price predictions) ---
# This is hosted in a separate repository; see docs/architecture.md
ML_API_BASE_URL=https://api-test-049u.onrender.com

# --- Reddit API (required by the sentiment job) ---
# Register a "script" application at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
USER_AGENT=quantia-sentiment-bot/0.1.0

# --- OpenAI API (used by the sentiment-job summarizer) ---
OPENAI_API_KEY=

# --- Sentiment job options ---
ASSET=bitcoin
LOG_LEVEL=INFO
