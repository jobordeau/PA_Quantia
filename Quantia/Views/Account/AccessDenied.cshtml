@{
    Layout = null;
    ViewBag.Title = "Access denied";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access denied</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background: white;
            padding: 40px 50px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            text-align: center;
            max-width: 420px;
        }
        h1 { color: #b91c1c; margin: 0 0 12px; }
        a { color: #1d4ed8; text-decoration: none; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Access denied</h1>
        <p>You don't have permission to view this page.</p>
        <p><a href="@Url.Action("Login", "Account")">Sign in</a> with a different account.</p>
    </div>
</body>
</html>
